      "content": "<!-- wp:group {\"align\":\"full\",\"className\":\"is-style-slider nk-hero\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"bottom\":\"0\"}}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignfull is-style-slider nk-hero\" style=\"padding-top:0;padding-bottom:0\"><!-- wp:cover {\"overlayColor\":\"red\",\"minHeight\":460,\"contentPosition\":\"center left\",\"isDark\":true,\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-cover is-dark has-custom-content-position is-position-center-left\" style=\"min-height:460px\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-red-background-color has-background-dim-100 has-background-dim\"></span><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"className\":\"nk-hero__card\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group nk-hero__card\"><!-- wp:paragraph {\"className\":\"is-style-kicker\",\"textColor\":\"cream\"} -->\n<p class=\"is-style-kicker has-cream-color has-text-color\">Nostek Market</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"is-style-title-3d\",\"textColor\":\"cream\"} -->\n<h2 class=\"wp-block-heading is-style-title-3d has-cream-color has-text-color\">Gadget pilihan, sudah kami coba</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"textColor\":\"cream\"} -->\n<p class=\"has-cream-color has-text-color\">Perangkat yang kami pakai sendiri, dengan review jujur di Journal.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"textColor\":\"cream\",\"className\":\"is-style-ruled\"} -->\n<div class=\"wp-block-button is-style-ruled\"><a class=\"wp-block-button__link has-cream-color has-text-color wp-element-button\" href=\"/shop/\">Lihat semua produk</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group --></div></div>\n<!-- /wp:cover -->\n\n<!-- wp:cover {\"overlayColor\":\"teal-dark\",\"minHeight\":460,\"contentPosition\":\"center left\",\"isDark\":true,\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-cover is-dark has-custom-content-position is-position-center-left\" style=\"min-height:460px\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-teal-dark-background-color has-background-dim-100 has-background-dim\"></span><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"className\":\"nk-hero__card\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group nk-hero__card\"><!-- wp:paragraph {\"className\":\"is-style-kicker\",\"textColor\":\"cream\"} -->\n<p class=\"is-style-kicker has-cream-color has-text-color\">Jaringan &amp; homelab</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"is-style-title-3d\",\"textColor\":\"cream\"} -->\n<h2 class=\"wp-block-heading is-style-title-3d has-cream-color has-text-color\">Perangkat untuk rak impianmu</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"textColor\":\"cream\"} -->\n<p class=\"has-cream-color has-text-color\">Router, switch, mini PC dan NAS yang lolos uji kami.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"textColor\":\"cream\",\"className\":\"is-style-ruled\"} -->\n<div class=\"wp-block-button is-style-ruled\"><a class=\"wp-block-button__link has-cream-color has-text-color wp-element-button\" href=\"/shop/\">Belanja sekarang</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group --></div></div>\n<!-- /wp:cover -->\n\n<!-- wp:cover {\"overlayColor\":\"mustard\",\"minHeight\":460,\"contentPosition\":\"center left\",\"isDark\":true,\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-cover is-dark has-custom-content-position is-position-center-left\" style=\"min-height:460px\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-mustard-background-color has-background-dim-100 has-background-dim\"></span><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"className\":\"nk-hero__card\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group nk-hero__card\"><!-- wp:paragraph {\"className\":\"is-style-kicker\",\"textColor\":\"ink\"} -->\n<p class=\"is-style-kicker has-ink-color has-text-color\">Review dulu, baru beli</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"is-style-title-3d\",\"textColor\":\"cream\"} -->\n<h2 class=\"wp-block-heading is-style-title-3d has-cream-color has-text-color\">Baca review sebelum checkout</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"textColor\":\"ink\"} -->\n<p class=\"has-ink-color has-text-color\">Setiap produk punya cerita di rubrik Reviews.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"textColor\":\"ink\",\"className\":\"is-style-ruled\"} -->\n<div class=\"wp-block-button is-style-ruled\"><a class=\"wp-block-button__link has-ink-color has-text-color wp-element-button\" href=\"/category/reviews/\">Baca Reviews</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group --></div></div>\n<!-- /wp:cover --></div>\n<!-- /wp:group -->\n\n<!-- wp:heading {\"className\":\"is-style-divider\"} -->\n<h2 class=\"wp-block-heading is-style-divider\">Produk Terbaru</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"align\":\"wide\",\"className\":\"is-style-carousel\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide is-style-carousel\"><!-- wp:woocommerce/product-collection {\"queryId\":40,\"query\":{\"perPage\":8,\"pages\":1,\"offset\":0,\"postType\":\"product\",\"order\":\"desc\",\"orderBy\":\"date\",\"search\":\"\",\"exclude\":[],\"inherit\":false,\"taxQuery\":[],\"isProductCollectionBlock\":true,\"featured\":false,\"woocommerceOnSale\":false,\"woocommerceStockStatus\":[\"instock\",\"onbackorder\"],\"woocommerceAttributes\":[],\"woocommerceHandPickedProducts\":[]},\"tagName\":\"div\",\"displayLayout\":{\"type\":\"flex\",\"columns\":4,\"shrinkColumns\":true},\"collection\":\"woocommerce/product-collection/new-arrivals\",\"hideControls\":[\"inherit\",\"order\",\"filterable\"]} -->\n<div class=\"wp-block-woocommerce-product-collection\"><!-- wp:woocommerce/product-template -->\n<!-- wp:woocommerce/product-image {\"showSaleBadge\":false,\"isDescendentOfQueryLoop\":true} -->\n<!-- wp:woocommerce/product-sale-badge {\"isDescendentOfQueryLoop\":true,\"align\":\"right\"} /-->\n<!-- /wp:woocommerce/product-image -->\n\n<!-- wp:post-title {\"textAlign\":\"center\",\"level\":3,\"isLink\":true,\"fontSize\":\"medium\",\"__woocommerceNamespace\":\"woocommerce/product-collection/product-title\"} /-->\n\n<!-- wp:woocommerce/product-price {\"isDescendentOfQueryLoop\":true,\"textAlign\":\"center\"} /-->\n\n<!-- wp:woocommerce/product-button {\"isDescendentOfQueryLoop\":true,\"textAlign\":\"center\"} /-->\n<!-- /wp:woocommerce/product-template --></div>\n<!-- /wp:woocommerce/product-collection --></div>\n<!-- /wp:group -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/shop/\">Lihat semua produk</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->",
