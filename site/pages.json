center left\",\"isDark\":true,\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-cover is-dark has-custom-content-position is-position-center-left\" style=\"min-height:460px\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-teal-dark-background-color has-background-dim-100 has-background-dim\"></span><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"className\":\"nk-hero__card\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group nk-hero__card\"><!-- wp:paragraph {\"className\":\"is-style-kicker\",\"textColor\":\"cream\"} -->\n<p class=\"is-style-kicker has-cream-color has-text-color\">Jaringan &amp; homelab</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"className\":\"is-style-title-3d\",\"textColor\":\"cream\"} -->\n<h2 class=\"wp-block-heading is-style-title-3d has-cream-color has-text-color\">Perangkat untuk rak impianmu</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"textColor\":\"cream\"} -->\n<p class=\"has-cream-color has-text-color\">Router, switch, mini PC dan NAS yang lolos uji kami.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"textColor\":\"cream\",\"className\":\"is-style-ruled\"} -->\n<div class=\"wp-block-button is-style-ruled\"><a class=\"wp-block-button__link has-cream-color has-text-color wp-element-button\" href=\"/shop/\">Belanja sekarang</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group --></div></div>\n<!-- /wp:cover -->\n\n<!-- wp:cover {\"overlayColor\":\"mustard\",\"minHeight\":460,\"contentPosition\":\"center left\",\"isDark\":true,\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-cover is-dark has-custom-content-position is-position-center-left\" style=\"min-height:460px\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-mustard-background-color has-background-dim-100 has-background-dim\"></span><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"cla